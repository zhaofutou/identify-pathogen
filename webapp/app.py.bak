    kraken2_ready = wsl_path_exists('/root/outbreak_investigation/kraken2_db/hash.k2d')
    print(f"  Kraken2:     {'✅ Ready' if kraken2_ready else '⚠️  Not ready (using minimap2 fallback)'}")
    print(f"  Access:      http://0.0.0.0:5000")
    print("=" * 60)

    app.run(host='0.0.0.0', port=5000, debug=False, threaded=True)
